// Socrates NQ - TradingView port of the NinjaTrader 8 strategy.
//
// Same six steps, same parameter names, same defaults as
// src/NinjaTrader8/Strategies/SocratesNQ.cs, so settings carry across:
//
//   1. Context    - a book of reference levels (prior day/week, pivots, swings, order blocks)
//   2. Liquidity  - price sweeps beyond a level and closes back inside
//   3. Structure  - the failing move breaks opposing structure with displacement
//   4. Retest     - entry on the return to the defended area, never on the sweep
//   5. VIX        - the VIX must be moving inversely
//   6. Breadth    - the market leaders must be participating
//
// Differences from the NinjaTrader build are listed at the bottom of this file. The most
// useful one: TradingView carries VIX and US equity data, so steps 5 and 6 are actually
// testable here, which they are not on a futures-only NinjaTrader feed.

//@version=6
strategy("Socrates NQ", "Socrates", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 25000, currency = currency.USD,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════════════════
// Inputs - grouped and named to match the NinjaTrader parameter panel
// ═══════════════════════════════════════════════════════════════════════════

gSize   = "1. Position Sizing"
gRisk   = "2. Risk"
gCtx    = "3. Step 1 - Context"
gLiq    = "4. Step 2 - Liquidity"
gStruct = "5. Step 3 - Structure"
gRetest = "6. Step 4 - Retest"
gVix    = "7. Step 5 - VIX"
gBrd    = "8. Step 6 - Leaders"
gChart  = "9. Chart"

fixedContracts = input.int(1, "Fixed contracts", minval = 1, group = gSize)
maxContracts   = input.int(1, "Max contracts", minval = 1, group = gSize)

tradingHours  = input.string("Extended", "Trading hours", options = ["Regular", "Extended", "Custom"], group = gRisk,
     tooltip = "Regular 09:45-15:45 ET. Extended 18:00-16:45 ET, the full Globex session. Custom uses the three times below.")
customStart   = input.int(94500,  "Session start (HHmmss)", group = gRisk)
customEnd     = input.int(154500, "Session end (HHmmss)",   group = gRisk)
customFlatten = input.int(155500, "Flatten time (HHmmss)",  group = gRisk)
maxDailyLoss  = input.float(0, "Max daily loss ($)", minval = 0, group = gRisk,
     tooltip = "0 disables. Must be larger than a single stop-out or it refuses most setups.")
maxTradesDay  = input.int(3, "Max trades per day", minval = 0, group = gRisk)
maxConsecLoss = input.int(2, "Max consecutive losses", minval = 0, group = gRisk)

atrPeriod      = input.int(14, "ATR period", minval = 1, group = gCtx)
swingStrength  = input.int(3, "Swing strength", minval = 1, group = gCtx)
useFourHour    = input.bool(true, "Use 4-hour pivots", group = gCtx)
openRangeMin   = input.int(15, "Opening range (minutes)", minval = 1, group = gCtx)
zoneHalfAtr    = input.float(0.25, "Zone half-width (ATR)", minval = 0.01, step = 0.05, group = gCtx)
levelMergeAtr  = input.float(0.35, "Level merge distance (ATR)", minval = 0, step = 0.05, group = gCtx)
useOrderBlocks = input.bool(true, "Use order blocks", group = gCtx)
obRequireGap   = input.bool(true, "Order block needs imbalance", group = gCtx)
obDisplaceAtr  = input.float(1.0, "Order block displacement (ATR)", minval = 0.1, step = 0.1, group = gCtx)
obLookback     = input.int(10, "Order block origin lookback", minval = 1, group = gCtx)
maxSwingLevels = input.int(24, "Max swing levels", minval = 4, group = gCtx)
pruneAtr       = input.float(12.0, "Prune distance (ATR)", minval = 1, group = gCtx)

minPenAtr      = input.float(0.25, "Min penetration (ATR)", minval = 0, step = 0.05, group = gLiq)
minPenPoints   = input.float(2.0, "Min penetration (points)", minval = 0, step = 0.25, group = gLiq)
maxBarsReclaim = input.int(6, "Max bars to reclaim", minval = 1, group = gLiq)
enableCont     = input.bool(false, "Trade continuations", group = gLiq,
     tooltip = "Breaks that hold: price goes through a level, does not reclaim, then retests it from the other side. Measured at -0.08R over 147 trades in its unselective form, so it ships off.")
contMajorOnly  = input.bool(true, "Continuations on major levels only", group = gLiq)

maxBarsToShift = input.int(20, "Max bars sweep to shift", minval = 1, group = gStruct)
usePostSweep   = input.bool(true, "Use post-sweep swing", group = gStruct)
minDisplaceAtr = input.float(1.0, "Min displacement (ATR)", minval = 0, step = 0.1, group = gStruct)
maxSetupRisk   = input.float(2.5, "Max setup risk (ATR)", minval = 0, step = 0.25, group = gStruct)
maxStructDist  = input.float(5.0, "Max structure distance (ATR)", minval = 0, step = 0.25, group = gStruct)

maxBarsToRetest = input.int(15, "Max bars shift to retest", minval = 1, group = gRetest)
retestZoneAtr   = input.float(0.30, "Retest zone width (ATR)", minval = 0.01, step = 0.05, group = gRetest)
requireConfirm  = input.bool(true, "Require confirmation close", group = gRetest)
stopBufferAtr   = input.float(0.25, "Stop buffer (ATR)", minval = 0, step = 0.05, group = gRetest)
targetBufferTk  = input.int(4, "Target buffer (ticks)", minval = 0, group = gRetest)
minRewardRisk   = input.float(1.0, "Min reward:risk", minval = 0, step = 0.1, group = gRetest)
targetRFallback = input.float(2.0, "Target (R multiple) fallback", minval = 0, step = 0.1, group = gRetest)
minStopTicks    = input.int(20, "Min stop (ticks)", minval = 1, group = gRetest)
maxStopTicks    = input.int(400, "Max stop (ticks)", minval = 1, group = gRetest)

vixMode       = input.string("Off", "VIX mode", options = ["Off", "Directional"], group = gVix)
vixSymbol     = input.symbol("CBOE:VIX", "VIX symbol", group = gVix,
     tooltip = "CBOE:VIX is the index. On TradingView it carries far more history than a VX futures contract, and unlike NinjaTrader the data is there.")
vixLookback   = input.int(6, "VIX lookback bars", minval = 1, group = gVix)
vixMinMove    = input.float(0.02, "VIX min move (floor)", minval = 0, step = 0.01, group = gVix)
vixMinMoveAtr = input.float(0.5, "VIX min move (ATR)", minval = 0, step = 0.1, group = gVix)

breadthMode = input.string("Off", "Breadth mode", options = ["Off", "Directional"], group = gBrd)
ldr1 = input.symbol("NASDAQ:AAPL",  "Leader 1", group = gBrd)
ldr2 = input.symbol("NASDAQ:MSFT",  "Leader 2", group = gBrd)
ldr3 = input.symbol("NASDAQ:NVDA",  "Leader 3", group = gBrd)
ldr4 = input.symbol("NASDAQ:AMZN",  "Leader 4", group = gBrd)
ldr5 = input.symbol("NASDAQ:META",  "Leader 5", group = gBrd)
ldr6 = input.symbol("NASDAQ:GOOGL", "Leader 6", group = gBrd)
ldr7 = input.symbol("NASDAQ:TSLA",  "Leader 7", group = gBrd)
breadthMinAlign = input.int(5, "Min leaders aligned", minval = 1, maxval = 7, group = gBrd)
breadthMinMove  = input.float(0.05, "Min leader move (%)", minval = 0, step = 0.01, group = gBrd)
breadthOpen     = input.int(93000,  "Leaders open (HHmmss)",  group = gBrd)
breadthClose    = input.int(160000, "Leaders close (HHmmss)", group = gBrd)

showVisuals = input.bool(true, "Show chart visuals", group = gChart)
showZones   = input.bool(true, "Show setup zones", group = gChart)
showLevels  = input.bool(false, "Show reference levels", group = gChart,
     tooltip = "Off by default. There are usually thirty-odd and they clutter the chart.")
showPanel   = input.bool(true, "Show stats panel", group = gChart)

// ═══════════════════════════════════════════════════════════════════════════
// Types
// ═══════════════════════════════════════════════════════════════════════════

// major separates a reference the whole market can see - prior day and week, pivots, the
// overnight and opening ranges - from a swing or order block the price action happened to
// leave behind. Continuations use it: a break of the prior day's high is an event, a
// break of the fourteenth swing high is not.
type Level
    float price
    float halfWidth
    bool  major

type Block
    float top
    float bottom
    bool  bullish

// ═══════════════════════════════════════════════════════════════════════════
// Functions - Pine allows declarations at global scope only
// ═══════════════════════════════════════════════════════════════════════════

// Inclusive window that may wrap midnight, as the Globex session does.
inWindow(int t, int startT, int endT) =>
    startT == endT ? true : startT < endT ? (t >= startT and t <= endT) : (t >= startT or t <= endT)

// Classic floor pivots from a completed period.
pivP(float h, float l, float c) => (h + l + c) / 3.0
pivR1(float h, float l, float c) => 2.0 * ((h + l + c) / 3.0) - l
pivS1(float h, float l, float c) => 2.0 * ((h + l + c) / 3.0) - h
pivR2(float h, float l, float c) => (h + l + c) / 3.0 + (h - l)
pivS2(float h, float l, float c) => (h + l + c) / 3.0 - (h - l)

// Callers add in order of significance, so what is already in the book wins a merge.
// The size guard matters: "for i = 0 to array.size(a) - 1" on an empty array counts
// downward from 0 to -1 and reads index -1.
addLevel(array<Level> arr, float px, bool major, float merge, float hw) =>
    if not na(px) and px > 0
        dup = false
        if merge > 0 and array.size(arr) > 0
            for i = 0 to array.size(arr) - 1
                if math.abs(array.get(arr, i).price - px) < merge
                    dup := true
                    break
        if not dup
            array.push(arr, Level.new(px, hw, major))

// Most recent confirmed swing strictly after a bar index - the near one, which gives an
// earlier signal and a stop proportional to the move. Falling back to the swing that
// preceded the sweep means breaking the origin of the whole prior leg.
swingAfter(array<float> prices, array<int> bars, int barIdx) =>
    float r = na
    if array.size(bars) > 0
        for i = array.size(bars) - 1 to 0
            if array.get(bars, i) > barIdx
                r := array.get(prices, i)
            else
                break
    r

// Most recent swing at least minDistance away, walking back past ones too close to be
// worth aiming at.
swingBeyond(array<float> prices, float px, float minDistance, bool above) =>
    float r = na
    if array.size(prices) > 0
        for i = array.size(prices) - 1 to 0
            v = array.get(prices, i)
            if above ? v >= px + minDistance : v <= px - minDistance
                r := v
                break
    r

// A reversal trades against the move that took the level; a continuation trades with it.
// Same event, opposite mapping.
isBullish(bool buySide, bool cont) => cont ? buySide : not buySide

// ═══════════════════════════════════════════════════════════════════════════
// Session arithmetic - HHmmss integers in exchange time, as in NinjaTrader
// ═══════════════════════════════════════════════════════════════════════════

tod = hour * 10000 + minute * 100 + second

sessStart = tradingHours == "Regular" ? 94500  : tradingHours == "Extended" ? 180000 : customStart
sessEnd   = tradingHours == "Regular" ? 154500 : tradingHours == "Extended" ? 164500 : customEnd
flattenAt = tradingHours == "Regular" ? 155500 : tradingHours == "Extended" ? 165500 : customFlatten

// Half-open [flatten, next session start). A bare "t >= flatten" is only right for a
// window that ends in the evening and does not reopen; on 18:00-16:45 it stays true
// through midnight and the overnight half of the session could never trade.
shouldFlatten = flattenAt == sessStart ? false :
     sessStart < flattenAt ? (tod >= flattenAt or tod < sessStart) : (tod >= flattenAt and tod < sessStart)

withinSession = inWindow(tod, sessStart, sessEnd)
leadersOpen   = inWindow(tod, breadthOpen, breadthClose)

// ═══════════════════════════════════════════════════════════════════════════
// Higher timeframe data - lookahead off throughout, so no future leaks in
// ═══════════════════════════════════════════════════════════════════════════

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_off)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_off)

pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_off)
pwc = request.security(syminfo.tickerid, "W", close[1], lookahead = barmerge.lookahead_off)

p4h = request.security(syminfo.tickerid, "240", high[1], lookahead = barmerge.lookahead_off)
p4l = request.security(syminfo.tickerid, "240", low[1],  lookahead = barmerge.lookahead_off)
p4c = request.security(syminfo.tickerid, "240", close[1], lookahead = barmerge.lookahead_off)

vixClose = request.security(vixSymbol, timeframe.period, close, lookahead = barmerge.lookahead_off)
vixAtr   = request.security(vixSymbol, timeframe.period, ta.atr(atrPeriod), lookahead = barmerge.lookahead_off)

// Each leader as percent change from its own session open - "is this name participating
// today", the measure the NinjaTrader build uses.
leaderPct(simple string sym) =>
    request.security(sym, timeframe.period,
         (close - ta.valuewhen(session.isfirstbar_regular, open, 0)) / ta.valuewhen(session.isfirstbar_regular, open, 0) * 100.0,
         lookahead = barmerge.lookahead_off)

l1 = leaderPct(ldr1)
l2 = leaderPct(ldr2)
l3 = leaderPct(ldr3)
l4 = leaderPct(ldr4)
l5 = leaderPct(ldr5)
l6 = leaderPct(ldr6)
l7 = leaderPct(ldr7)

// ═══════════════════════════════════════════════════════════════════════════
// Step 1 - context
// ═══════════════════════════════════════════════════════════════════════════

atr = ta.atr(atrPeriod)
newSession = ta.change(time("D")) != 0

// ta.pivothigh/low is exactly the swing definition used in NinjaTrader: n bars either
// side, confirmed n bars late. The lag is real and is not a bug.
ph = ta.pivothigh(high, swingStrength, swingStrength)
pl = ta.pivotlow(low, swingStrength, swingStrength)

var array<float> swingHighs    = array.new<float>()
var array<float> swingLows     = array.new<float>()
var array<int>   swingHighBars = array.new<int>()
var array<int>   swingLowBars  = array.new<int>()

if not na(ph)
    array.push(swingHighs, ph)
    array.push(swingHighBars, bar_index - swingStrength)
    if array.size(swingHighs) > 100
        array.shift(swingHighs)
        array.shift(swingHighBars)

if not na(pl)
    array.push(swingLows, pl)
    array.push(swingLowBars, bar_index - swingStrength)
    if array.size(swingLows) > 100
        array.shift(swingLows)
        array.shift(swingLowBars)

// Overnight and opening ranges, reset each session.
var float onHigh = na
var float onLow  = na
var float orHigh = na
var float orLow  = na

isOvernight = tod >= 180000 or tod < 93000
inOpenRange = tod >= 93000 and tod < 93000 + openRangeMin * 100

if newSession
    onHigh := na
    onLow  := na
    orHigh := na
    orLow  := na

if isOvernight
    onHigh := na(onHigh) ? high : math.max(onHigh, high)
    onLow  := na(onLow)  ? low  : math.min(onLow, low)

if inOpenRange
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)

// The level book, rebuilt each bar. Cheaper than lifetime management, and the touch
// counts it would preserve are not read by anything downstream.
var array<Level> levels = array.new<Level>()
array.clear(levels)

mergeDist = atr * levelMergeAtr
halfWidth = atr * zoneHalfAtr

addLevel(levels, pdh, true, mergeDist, halfWidth)
addLevel(levels, pdl, true, mergeDist, halfWidth)
addLevel(levels, pdc, true, mergeDist, halfWidth)
addLevel(levels, pwh, true, mergeDist, halfWidth)
addLevel(levels, pwl, true, mergeDist, halfWidth)
addLevel(levels, pivP(pdh, pdl, pdc), true, mergeDist, halfWidth)
addLevel(levels, pivR1(pdh, pdl, pdc), true, mergeDist, halfWidth)
addLevel(levels, pivS1(pdh, pdl, pdc), true, mergeDist, halfWidth)
addLevel(levels, pivR2(pdh, pdl, pdc), true, mergeDist, halfWidth)
addLevel(levels, pivS2(pdh, pdl, pdc), true, mergeDist, halfWidth)
addLevel(levels, pivP(pwh, pwl, pwc), true, mergeDist, halfWidth)
addLevel(levels, pivR1(pwh, pwl, pwc), true, mergeDist, halfWidth)
addLevel(levels, pivS1(pwh, pwl, pwc), true, mergeDist, halfWidth)
addLevel(levels, useFourHour ? pivP(p4h, p4l, p4c) : na, true, mergeDist, halfWidth)
addLevel(levels, useFourHour ? pivR1(p4h, p4l, p4c) : na, true, mergeDist, halfWidth)
addLevel(levels, useFourHour ? pivS1(p4h, p4l, p4c) : na, true, mergeDist, halfWidth)
addLevel(levels, onHigh, true, mergeDist, halfWidth)
addLevel(levels, onLow,  true, mergeDist, halfWidth)
addLevel(levels, orHigh, true, mergeDist, halfWidth)
addLevel(levels, orLow,  true, mergeDist, halfWidth)

// Swing extremes are liquidity pools, not major references.
pruneDist = atr * pruneAtr

if array.size(swingHighs) > 0
    for i = math.max(0, array.size(swingHighs) - maxSwingLevels) to array.size(swingHighs) - 1
        px = array.get(swingHighs, i)
        if math.abs(px - close) <= pruneDist
            addLevel(levels, px, false, mergeDist, halfWidth)

if array.size(swingLows) > 0
    for i = math.max(0, array.size(swingLows) - maxSwingLevels) to array.size(swingLows) - 1
        px = array.get(swingLows, i)
        if math.abs(px - close) <= pruneDist
            addLevel(levels, px, false, mergeDist, halfWidth)

// Order blocks: the last opposing candle before a displacement move, optionally
// requiring a three-bar fair value gap. Without the gap requirement, "last opposing
// candle" matches something on nearly every bar.
var array<Block> blocks = array.new<Block>()

if useOrderBlocks and bar_index > obLookback + 4
    if high[2] - low[2] >= atr * obDisplaceAtr
        bullGap = low > high[3]
        bearGap = high < low[3]
        if close[2] > open[2] and (bullGap or not obRequireGap)
            for i = 3 to obLookback + 2
                if close[i] < open[i]
                    array.push(blocks, Block.new(high[i], low[i], true))
                    break
        else if close[2] < open[2] and (bearGap or not obRequireGap)
            for i = 3 to obLookback + 2
                if close[i] > open[i]
                    array.push(blocks, Block.new(high[i], low[i], false))
                    break
    while array.size(blocks) > 12
        array.shift(blocks)

// A block retires the moment price closes clean through it.
if array.size(blocks) > 0
    for i = array.size(blocks) - 1 to 0
        b = array.get(blocks, i)
        if (b.bullish and close < b.bottom) or (not b.bullish and close > b.top)
            array.remove(blocks, i)

// Order blocks join the book as supply and demand, never as major references.
if array.size(blocks) > 0
    for i = 0 to array.size(blocks) - 1
        b = array.get(blocks, i)
        array.push(levels, Level.new((b.top + b.bottom) / 2.0, (b.top - b.bottom) / 2.0, false))

// ═══════════════════════════════════════════════════════════════════════════
// Step 2 - liquidity. Penetration then reclaim; or penetration that holds.
// ═══════════════════════════════════════════════════════════════════════════

minPen = math.max(minPenPoints, atr * minPenAtr)
searchDist = math.max(atr * 3.0, minPen * 4.0)

var bool  buyActive = false
var float buyLevelPx = na
var bool  buyMajor = false
var float buyExtreme = na
var int   buyStartBar = 0

var bool  sellActive = false
var float sellLevelPx = na
var bool  sellMajor = false
var float sellExtreme = na
var int   sellStartBar = 0

evValid = false
evBuySide = false
evCont = false
evLevelPx = 0.0
evExtreme = 0.0
evExtremeBar = 0

if not buyActive
    float takenPx = na
    takenMajor = false
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lv = array.get(levels, i)
            // Several levels exceeded at once: the highest is the pool price reached for.
            if high > lv.price + lv.halfWidth + minPen and high - lv.price <= searchDist and (na(takenPx) or lv.price > takenPx)
                takenPx := lv.price
                takenMajor := lv.major
    if not na(takenPx)
        buyActive := true
        buyLevelPx := takenPx
        buyMajor := takenMajor
        buyExtreme := high
        buyStartBar := bar_index
else
    buyExtreme := math.max(buyExtreme, high)
    if close < buyLevelPx
        evValid := true
        evBuySide := true
        evCont := false
        evLevelPx := buyLevelPx
        evExtreme := buyExtreme
        evExtremeBar := bar_index
        buyActive := false
    else if bar_index - buyStartBar >= maxBarsReclaim
        // Never came back: a genuine break. Only an event when continuations are wanted.
        if enableCont and close > buyLevelPx and (not contMajorOnly or buyMajor)
            evValid := true
            evBuySide := true
            evCont := true
            evLevelPx := buyLevelPx
            evExtreme := buyExtreme
            evExtremeBar := bar_index
        buyActive := false

if not sellActive
    float takenPx = na
    takenMajor = false
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lv = array.get(levels, i)
            if low < lv.price - lv.halfWidth - minPen and lv.price - low <= searchDist and (na(takenPx) or lv.price < takenPx)
                takenPx := lv.price
                takenMajor := lv.major
    if not na(takenPx)
        sellActive := true
        sellLevelPx := takenPx
        sellMajor := takenMajor
        sellExtreme := low
        sellStartBar := bar_index
else
    sellExtreme := math.min(sellExtreme, low)
    if close > sellLevelPx
        // A reversal outranks a continuation found on the same bar.
        if not evValid or evCont
            evValid := true
            evBuySide := false
            evCont := false
            evLevelPx := sellLevelPx
            evExtreme := sellExtreme
            evExtremeBar := bar_index
        sellActive := false
    else if bar_index - sellStartBar >= maxBarsReclaim
        if enableCont and close < sellLevelPx and (not contMajorOnly or sellMajor) and not evValid
            evValid := true
            evBuySide := false
            evCont := true
            evLevelPx := sellLevelPx
            evExtreme := sellExtreme
            evExtremeBar := bar_index
        sellActive := false

// ═══════════════════════════════════════════════════════════════════════════
// Steps 3 and 4 - structure shift, then retest
// ═══════════════════════════════════════════════════════════════════════════

var int   stState = 0            // 0 idle, 1 awaiting shift, 2 awaiting retest
var bool  stBuySide = false
var bool  stCont = false
var float stLevelPx = na
var float stExtreme = na
var int   stExtremeBar = 0
var int   stSweepBar = 0
var float stStructPx = na
var int   stShiftBar = 0
var float stZoneCenter = na
var float stZoneHalf = na
var float stRetestExtreme = na
var bool  stZoneTouched = false

// Adopt a new event only when it is genuinely better information. Unconditional adoption
// demolished every setup before it could develop: with a dense level book events confirm
// every few bars, and a swing needs (2 x strength) + 1 bars just to confirm.
adopt = false
if evValid
    adopt := stState == 0 ? true : evBuySide != stBuySide ? true : (evBuySide ? evExtreme > stExtreme : evExtreme < stExtreme)

entryFire = false
entryLong = false
entryCont = false
entryStop = 0.0
entryTarget = 0.0

if adopt
    stBuySide := evBuySide
    stCont := evCont
    stLevelPx := evLevelPx
    stExtreme := evExtreme
    stExtremeBar := evExtremeBar
    stSweepBar := bar_index
    stZoneTouched := false
    bull = isBullish(evBuySide, evCont)
    if evCont
        // No structure shift to wait for: the break through the level is the structural
        // event. Straight to the retest, with the level expected to flip role.
        stShiftBar := bar_index
        stZoneCenter := evLevelPx
        stZoneHalf := math.max(atr * retestZoneAtr, syminfo.mintick)
        stRetestExtreme := bull ? low : high
        stState := 2
    else
        stStructPx := na
        stState := 1

else if stState == 1
    bull = isBullish(stBuySide, false)
    if bar_index - stSweepBar > maxBarsToShift
        stState := 0
    else
        cand = bull ? swingAfter(swingHighs, swingHighBars, stExtremeBar) : swingAfter(swingLows, swingLowBars, stExtremeBar)
        // When the post-sweep swing is wanted, wait for it rather than falling back to the
        // far one - the fallback quietly makes every setup its widest possible version.
        if usePostSweep and not na(cand)
            stStructPx := cand
        if not na(stStructPx) and (bull ? close > stStructPx : close < stStructPx)
            structDist = math.abs(stStructPx - stExtreme)
            enoughDisplacement = minDisplaceAtr <= 0 or (high - low) >= atr * minDisplaceAtr
            if maxStructDist > 0 and structDist > atr * maxStructDist
                stState := 0
            else if enoughDisplacement
                stShiftBar := bar_index
                stZoneCenter := stStructPx
                stZoneHalf := math.max(atr * retestZoneAtr, syminfo.mintick)
                stRetestExtreme := bull ? low : high
                stZoneTouched := false
                stState := 2

else if stState == 2
    bull = isBullish(stBuySide, stCont)

    // The pullback into the retest, tracked live. It has no confirmation lag, unlike a
    // swing, and it is the level the trade is actually betting holds.
    stRetestExtreme := bull ? math.min(stRetestExtreme, low) : math.max(stRetestExtreme, high)

    // A continuation's swept extreme sits in the trade's favour, so the reversal test
    // would fire on the first bar. A break dies when price closes back through it.
    invalid = stCont ? (bull ? close < stLevelPx - stZoneHalf : close > stLevelPx + stZoneHalf) : (bull ? low < stExtreme : high > stExtreme)

    if bar_index - stShiftBar > maxBarsToRetest or invalid
        stState := 0
    else
        zoneUp = stZoneCenter + stZoneHalf
        zoneDn = stZoneCenter - stZoneHalf
        if not stZoneTouched and low <= zoneUp and high >= zoneDn
            stZoneTouched := true
        confirms = not requireConfirm or (bull ? (close > open and close > zoneDn) : (close < open and close < zoneUp))
        if stZoneTouched and confirms
            stopPx = bull ? stRetestExtreme - atr * stopBufferAtr : stRetestExtreme + atr * stopBufferAtr
            risk = math.abs(close - stopPx)
            if risk > 0 and (maxSetupRisk <= 0 or risk <= atr * maxSetupRisk)
                tBuf = targetBufferTk * syminfo.mintick
                minTargetDist = tBuf + (minRewardRisk > 0 ? risk * minRewardRisk : 0)
                tSwing = bull ? swingBeyond(swingHighs, close, minTargetDist, true) : swingBeyond(swingLows, close, minTargetDist, false)
                float targetPx = na
                if not na(tSwing)
                    targetPx := bull ? tSwing - tBuf : tSwing + tBuf
                else if targetRFallback > 0
                    targetPx := bull ? close + risk * targetRFallback : close - risk * targetRFallback
                if not na(targetPx) and (minRewardRisk <= 0 or math.abs(targetPx - close) >= risk * minRewardRisk)
                    entryFire := true
                    entryLong := bull
                    entryStop := stopPx
                    entryTarget := targetPx
                    entryCont := stCont
                    stState := 0

// ═══════════════════════════════════════════════════════════════════════════
// Steps 5 and 6 - confirmations
// ═══════════════════════════════════════════════════════════════════════════

vixMove = vixClose - vixClose[vixLookback]

// Scaled to the VIX's own volatility, with an absolute floor. A fixed threshold set for
// the cash session is unreachable overnight, and the step then refuses everything.
vixThreshold = math.max(vixMinMove, nz(vixAtr) * vixMinMoveAtr)

// The VIX moves inversely: a long wants it falling, a short wants it rising.
vixAgrees = vixMode == "Off" ? true : na(vixClose) ? false : entryLong ? vixMove <= -vixThreshold : vixMove >= vixThreshold

leaderAligned(float pct, bool isLong, float minMove) =>
    na(pct) or math.abs(pct) < minMove ? false : isLong ? pct > 0 : pct < 0

alignedN = (leaderAligned(l1, entryLong, breadthMinMove) ? 1 : 0) + (leaderAligned(l2, entryLong, breadthMinMove) ? 1 : 0) +
     (leaderAligned(l3, entryLong, breadthMinMove) ? 1 : 0) + (leaderAligned(l4, entryLong, breadthMinMove) ? 1 : 0) +
     (leaderAligned(l5, entryLong, breadthMinMove) ? 1 : 0) + (leaderAligned(l6, entryLong, breadthMinMove) ? 1 : 0) +
     (leaderAligned(l7, entryLong, breadthMinMove) ? 1 : 0)

availableN = (na(l1) ? 0 : 1) + (na(l2) ? 0 : 1) + (na(l3) ? 0 : 1) + (na(l4) ? 0 : 1) +
     (na(l5) ? 0 : 1) + (na(l6) ? 0 : 1) + (na(l7) ? 0 : 1)

// Outside the leaders' session the step is skipped, not failed. There is no overnight
// ticker for these names, and a shut equity market is not evidence against a trade.
breadthAgrees = breadthMode == "Off" or not leadersOpen ? true :
     availableN == 0 ? false : alignedN >= math.ceil(breadthMinAlign * availableN / 7.0)

// ═══════════════════════════════════════════════════════════════════════════
// Risk gates
// ═══════════════════════════════════════════════════════════════════════════

var int   tradesToday = 0
var int   consecLosses = 0
var float dayStartProfit = 0.0
var bool  haltedToday = false

if newSession
    tradesToday := 0
    consecLosses := 0
    haltedToday := false
    dayStartProfit := strategy.netprofit

// Closed-trade bookkeeping, which is also where the consecutive-loss halt arms.
if strategy.closedtrades > nz(strategy.closedtrades[1])
    p = strategy.closedtrades.profit(strategy.closedtrades - 1)
    consecLosses := p < 0 ? consecLosses + 1 : p > 0 ? 0 : consecLosses
    if maxConsecLoss > 0 and consecLosses >= maxConsecLoss
        haltedToday := true

dayPnl = strategy.netprofit - dayStartProfit
if maxDailyLoss > 0 and dayPnl <= -maxDailyLoss
    haltedToday := true

stopTicks = entryFire ? math.abs(close - entryStop) / syminfo.mintick : 0.0
riskDollars = stopTicks * syminfo.mintick * syminfo.pointvalue * fixedContracts
budgetLeft = maxDailyLoss > 0 ? maxDailyLoss + math.min(0, dayPnl) : 1e12

canEnter = entryFire and strategy.position_size == 0 and withinSession and not shouldFlatten and
     not haltedToday and (maxTradesDay <= 0 or tradesToday < maxTradesDay) and
     stopTicks >= minStopTicks and stopTicks <= maxStopTicks and riskDollars <= budgetLeft and
     vixAgrees and breadthAgrees

// ═══════════════════════════════════════════════════════════════════════════
// Orders
// ═══════════════════════════════════════════════════════════════════════════

var float liveStop = na
var float liveTarget = na
var bool  liveCont = false

qty = math.min(fixedContracts, maxContracts)

if canEnter
    tradeId = entryCont ? (entryLong ? "contLong" : "contShort") : (entryLong ? "sweepLong" : "sweepShort")
    strategy.entry(tradeId, entryLong ? strategy.long : strategy.short, qty = qty)
    strategy.exit(tradeId + " x", from_entry = tradeId, stop = entryStop, limit = entryTarget)
    tradesToday += 1
    liveStop := entryStop
    liveTarget := entryTarget
    liveCont := entryCont

// End-of-day flatten outranks everything.
if shouldFlatten and strategy.position_size != 0
    strategy.close_all("flatten")

if haltedToday and strategy.position_size != 0
    strategy.close_all("risk halt")

if strategy.position_size == 0
    liveStop := na
    liveTarget := na

// ═══════════════════════════════════════════════════════════════════════════
// Visuals
// ═══════════════════════════════════════════════════════════════════════════

inPosition = strategy.position_size != 0

plot(showVisuals and inPosition ? liveStop : na, "Stop", color.new(color.red, 0), 2, plot.style_linebr)
plot(showVisuals and inPosition ? liveTarget : na, "Target", color.new(color.green, 0), 2, plot.style_linebr)

plotshape(showVisuals and canEnter and entryLong, "Long entry", shape.triangleup, location.belowbar, color.new(color.blue, 0), size = size.tiny)
plotshape(showVisuals and canEnter and not entryLong, "Short entry", shape.triangledown, location.abovebar, color.new(color.orange, 0), size = size.tiny)

// The zone shows what the strategy is watching, not only what it eventually did.
var box zoneBox = na
var int zoneBoxBar = -1

if showVisuals and showZones
    if stState == 2 and not na(stZoneCenter)
        if zoneBoxBar != stShiftBar
            zoneBoxBar := stShiftBar
            zoneBox := box.new(stShiftBar, stZoneCenter + stZoneHalf, bar_index, stZoneCenter - stZoneHalf,
                 border_color = color.new(stCont ? color.purple : color.blue, 40),
                 bgcolor = color.new(stCont ? color.purple : color.blue, 88))
        else if not na(zoneBox)
            box.set_right(zoneBox, bar_index)
    else
        zoneBoxBar := -1

if showVisuals and showLevels and barstate.islast and array.size(levels) > 0
    for i = 0 to array.size(levels) - 1
        lv = array.get(levels, i)
        line.new(bar_index - 60, lv.price, bar_index + 5, lv.price,
             color = color.new(lv.major ? color.gray : color.silver, lv.major ? 40 : 70),
             style = lv.major ? line.style_solid : line.style_dotted)

// Profit factor and per-trade dollars sit above R deliberately: with a structural stop
// the risk varies many-fold between trades, so R is not comparable across them.
var table panel = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 20), border_width = 1)

if showVisuals and showPanel and barstate.islast
    total = strategy.closedtrades
    pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na
    stateTxt = stState == 0 ? "Idle" : stState == 1 ? "AwaitingShift" : "AwaitingRetest"

    table.cell(panel, 0, 0, "SOCRATES", text_color = color.silver, text_size = size.small)
    table.cell(panel, 1, 0, stateTxt + (stCont and stState == 2 ? " (cont)" : ""), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 1, "trades", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 1, str.tostring(total), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 2, "won / lost", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 2, str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 3, "win rate", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 3, total > 0 ? str.tostring(strategy.wintrades * 100.0 / total, "#.#") + "%" : "-", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 4, "net", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 4, str.tostring(strategy.netprofit, "#"), text_color = strategy.netprofit >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(panel, 0, 5, "factor", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 5, na(pf) ? "-" : str.tostring(pf, "#.##"), text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 6, "per trade", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 6, total > 0 ? str.tostring(strategy.netprofit / total, "#") : "-", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 7, "today", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 7, str.tostring(tradesToday) + " trades", text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 8, "halted", text_color = color.gray, text_size = size.small)
    table.cell(panel, 1, 8, haltedToday ? "yes" : "no", text_color = haltedToday ? color.orange : color.gray, text_size = size.small)

// ═══════════════════════════════════════════════════════════════════════════
// Differences from the NinjaTrader build
// ═══════════════════════════════════════════════════════════════════════════
//
// Better here:
//   - VIX and US equities have data on TradingView, so steps 5 and 6 are testable. On a
//     NinjaTrader futures feed they are not, which is why both ship Off there. They ship
//     Off here too, so a first run matches the NinjaTrader baseline before anything else
//     is switched on.
//   - Tick size and point value come from the symbol rather than a parameter.
//
// Worse here, and worth knowing before comparing results:
//   - No 1-minute fill resolution. TradingView fills against the chart's own bars, so a
//     bar touching both stop and target resolves by its own assumption. Measured on the
//     NinjaTrader build that was worth about 0.6% of net - small, not nothing.
//   - Commission and slippage are set in the strategy Properties tab, not here. Set them.
//   - Strict mode is dropped from both confirmations. It needed the VIX to be reacting
//     from its own swing levels, which meant running a second level book on a second
//     instrument; Directional is what the NinjaTrader runs actually used.
//   - Order block detection does not widen an overlapping existing block, it adds a new
//     one. Twelve stay active either way.
//   - No funnel counters. If a run produces no trades, the NinjaTrader build is still the
//     better place to find out which step is stopping them.
//
// Carried over deliberately, because the NinjaTrader runs measured it:
//   - The stop anchors to the retest pullback, not the swept extreme. The extreme
//     measured 169-810 ticks; the pullback measured 80-434.
//   - Continuations ship off. Unselective they produced 144 of 147 entries at -0.08R.
//   - Adoption of a new sweep is conditional. Unconditional adoption meant 498 sweeps
//     produced 4 structure evaluations.
//   - Max structure distance and max setup risk are separate numbers, because the stop
//     stopped coming from the swept extreme and that distance no longer sets the risk.
